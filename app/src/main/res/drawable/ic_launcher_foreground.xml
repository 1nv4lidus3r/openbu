<?xml version="1.0" encoding="utf-8"?>
<!-- BamMate launcher icon: blue 3D printer on the near-black background.
     The 24-unit printer drawing (same as the status-bar icon) is scaled 2.4x and centred, so it
     stays inside the adaptive-icon safe zone on round and squircle masks. -->
